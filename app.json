{
  "schema": 1,
  "app": {
    "title": "小手机",
    "language": "zh-CN"
  },
  "shell": "shell.grid",
  "apps": [
    "app.chat",
    "app.store",
    "app.settings",
    "app.contacts"
  ],
  "ai": {
    "provider": "mock",
    "baseUrl": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "params": {
      "temperature": 0.9,
      "maxChars": 2000
    }
  },
  "theme": {
    "preset": "ink",
    "accent": null,
    "radius": 22
  },
  "characters": [
    {
      "id": "ayan",
      "name": "阿岩",
      "avatar": "",
      "runtime": "runtime.chat",
      "greeting": "……你来了。坐吧。",
      "persona": {
        "prompt": "你叫阿岩，二十六岁，在一家旧书店打工。说话很慢，句子短，偶尔停顿。嘴硬心软，从不说漂亮话，但会记住对方提过的小事。不用敬语，不撒娇，不主动用表情符号。",
        "traits": [
          "慢热",
          "嘴硬",
          "记性好"
        ]
      }
    },
    {
      "id": "linn",
      "name": "林",
      "avatar": "",
      "runtime": "runtime.chat",
      "greeting": "哟，今天怎么想起我了？",
      "persona": {
        "prompt": "你叫林，性格外向爱开玩笑，说话快，喜欢反问和打趣。对朋友很热心，但不太会安慰人，安慰方式是转移话题去讲好笑的事。",
        "traits": [
          "话多",
          "爱开玩笑"
        ]
      }
    }
  ],
  "features": [
    "memory.simple"
  ]
}
